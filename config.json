{
    "description": "Cloudflare 高质量节点筛选器 - 最终配置（已按需求调整）",
    "version": "3.0",

    "weights": {
        "speed": 5.0,
        "jitter": 8.0,
        "http_latency": 2.0,
        "tcp_latency": 0.0
    },
    "comment_weights": "速度5，抖动8（稳定性优先），HTTP延迟2，TCP延迟忽略",

    "per_country_thresholds": {
        "SG": {"min_speed_mbps": 100, "max_jitter_ms": 5,  "max_latency_ms": 50},
        "HK": {"min_speed_mbps": 100, "max_jitter_ms": 5,  "max_latency_ms": 50},
        "JP": {"min_speed_mbps": 50,  "max_jitter_ms": 10, "max_latency_ms": 200}
    },
    "comment_thresholds": "硬性淘汰标准，必须同时满足",

    "per_country_quotas": {
        "SG": 10,
        "HK": 10,
        "JP": 20
    },
    "comment_quotas": "按评分从高到低，每个国家最多输出数量",

    "allowed_countries": ["SG", "HK", "JP"],

    "test_params": {
        "bandwidth_mb": 20,
        "min_tests": 3,
        "timeout_sec": 30,
        "concurrency": 30
    },
    "comment_test": "测速文件20MB，测3次，超时30秒，并发30",

    "output": {
        "format": "text",
        "file": "ip.txt"
    },

    "USE_GLOBAL_MODE": false,
    "GLOBAL_TOP_N": 40,
    "PER_COUNTRY_TOP_N": {"SG": 10, "HK": 10, "JP": 20},
    "PER_COUNTRY_HARD_MAP": {
        "SG": {"min_speed": 100, "max_jitter": 5, "max_latency": 50},
        "HK": {"min_speed": 100, "max_jitter": 5, "max_latency": 50},
        "JP": {"min_speed": 50, "max_jitter": 10, "max_latency": 200}
    },

    "BANDWIDTH_CANDIDATES": 500,
    "TCP_PROBES": 3,
    "MIN_SUCCESS_RATE": 1.0,
    "TIMEOUT": 30.0,
    "SOCKET_DEFAULT_TIMEOUT": 30,

    "FILTER_COUNTRIES_ENABLED": true,
    "ALLOWED_COUNTRIES": ["SG", "HK", "JP"],
    "PRE_FILTER_BLOCKED_ENABLED": true,
    "PRE_FILTER_BLOCKED_COUNTRIES": ["CN"],
    "PRE_FILTER_PORT_ENABLED": true,
    "PRE_FILTER_PORTS": [443, 8443, 2053, 2083, 2087, 2096],

    "ENABLE_WXPUSHER": false,
    "CF_ENABLED": false,

    "ADDITIONAL_SOURCES": [
        {"url": "https://zip.cm.edu.kg/all.txt", "enabled": true},
        {"url": "https://countrymerge.pages.dev/all.txt", "enabled": true},
        {"url": "https://bestcf.pages.dev/random-region/HK/all.txt", "enabled": true},
        {"url": "https://bestcf.pages.dev/random-region/JP/all.txt", "enabled": true},
        {"url": "https://bestcf.pages.dev/random-region/SG/all.txt", "enabled": true},
        {"url": "https://bestcf.pages.dev/WARP/WARP-MASQUE-IPs-443.txt", "enabled": true},
        {"url": "https://bestcf.pages.dev/WARP/WARP-MASQUE-IPs-8443.txt", "enabled": true},
        {"url": "https://bestcf.pages.dev/entryip/50.txt", "enabled": true}
    ],

    "HTTP_LATENCY_WEIGHT": 2.0,
    "JITTER_WEIGHT": 8.0,
    "SPEED_WEIGHT": 5.0,
    "TCP_LATENCY_WEIGHT": 0.0,
    "HTTP_JITTER_SAMPLES": 10,

    "BANDWIDTH_SIZE_MB": 20.0,
    "BANDWIDTH_TIMEOUT": 30,
    "BANDWIDTH_WORKERS": 30,

    "TEST_AVAILABILITY": true,
    "HTTP_TEST_ENABLED": true,
    "FORCE_DIRECT": false,
    "IP_CALIBRATION_ENABLED": false,

    "GITHUB_SYNC_MAX_RETRIES": 0,
    "OUTPUT_FILE": "ip.txt"
}
